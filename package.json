{
  "name": "codex-monorepo",
  "private": true,
  "description": "Tools for repo-wide maintenance.",
  "scripts": {
    "format": "prettier --check *.json *.md docs/*.md .github/workflows/*.yml **/*.js",
    "format:fix": "prettier --write *.json *.md docs/*.md .github/workflows/*.yml **/*.js",
    "e2e:wasm-phase3-network": "node tools/auto-web/e2e-phase3-network.mjs",
    "e2e:wasm-phase4-fs-secrets": "node tools/auto-web/e2e-phase4-fs-secrets.mjs",
    "e2e:wasm-phase5-lifecycle": "node tools/auto-web/e2e-phase5-lifecycle.mjs",
    "verify:wasm-exports": "node tools/auto-web/verify-wasm-exports.mjs",
    "verify:host-contract": "node tools/auto-web/verify-host-contract.mjs",
    "verify:contract-goldens": "node tools/auto-web/verify-contract-goldens.mjs",
    "e2e:wasm-cancel-stress": "node tools/auto-web/e2e-cancel-stress.mjs",
    "build:wasm-bundles": "node tools/auto-web/build-wasm-bundles.mjs",
    "e2e:wasm-browser-puppeteer": "node tools/auto-web/e2e-browser-puppeteer.mjs",
    "e2e:wasm-milestone": "node tools/auto-web/verify-host-contract.mjs && node tools/auto-web/verify-contract-goldens.mjs && node tools/auto-web/verify-wasm-exports.mjs && node tools/auto-web/host-harness.js --wasm && node tools/auto-web/e2e-phase3-network.mjs && node tools/auto-web/e2e-phase4-fs-secrets.mjs && node tools/auto-web/e2e-phase5-lifecycle.mjs && node tools/auto-web/e2e-cancel-stress.mjs && node tools/auto-web/e2e-browser-puppeteer.mjs",
    "write-hooks-schema": "cargo run --manifest-path ./codex-rs/Cargo.toml -p codex-hooks --bin write_hooks_schema_fixtures"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "puppeteer": "^24.39.1"
  },
  "resolutions": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "semver": "^7.7.1"
  },
  "overrides": {
    "punycode": "^2.3.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.29.3"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer",
      "@puppeteer/browsers"
    ]
  }
}
